{
  "name": "mylifedata-matrix-service",
  "version": "1.0.0", 
  "description": "MyLifeData Matrix Communication Intelligence Web Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm install --include=dev && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node server.ts",
    "clean": "rimraf dist",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5", 
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17", 
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}